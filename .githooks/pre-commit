#!/bin/sh
# ShirazMCP pre-commit hook — runs the SAME gate as CI (.github/workflows/ci.yml)
# so formatting/lint/test failures are caught locally, not on GitHub.
#
# Enable once per clone:   git config core.hooksPath .githooks
# Skip for one commit:     git commit --no-verify

set -e
cd "$(git rev-parse --show-toplevel)"

echo "pre-commit: cargo fmt --all --check"
if ! cargo fmt --all --check; then
    echo "✗ formatting — fix with:  cargo fmt --all" >&2
    exit 1
fi

echo "pre-commit: cargo clippy --all-targets --all-features -- -D warnings"
cargo clippy --all-targets --all-features -- -D warnings

echo "pre-commit: cargo test --all-features"
cargo test --all-features

echo "✓ pre-commit gate passed"
